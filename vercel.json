{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/ubuntu-core/v86.wasm", "destination": "/v86.wasm" },
    { "source": "/api/ubuntu-core/seabios.bin", "destination": "/os-images/seabios.bin" },
    { "source": "/api/ubuntu-core/vgabios.bin", "destination": "/os-images/vgabios.bin" },
    { "source": "/api/ubuntu-core/vmlinuz", "destination": "/os-images/vmlinuz" },
    { "source": "/api/ubuntu-core/initrd", "destination": "/os-images/initrd.cpio.gz" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/os-images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
